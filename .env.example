# Public frontend configuration
VITE_API_URL=http://127.0.0.1:5000
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id

# Flask server
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false

# MongoDB Atlas
# Copy the complete URI from Atlas. Replace only the username, password, and database if needed.
# The cluster hostname is required; username/password alone cannot form a connection.
MONGO_URI=mongodb+srv://<db-user>:<db-password>@<cluster-hostname>/SmartAds?retryWrites=true&w=majority
DATABASE_NAME=SmartAds

# One-time admin provisioning (used by backend/scripts/seed_admin.py)
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_NAME=SmartAds Admin

# OpenAI image generation (if using OpenAI for logos/posters)
OPENAI_API_KEY=your-openai-api-key
OPENAI_IMAGE_MODEL=gpt-image-1

# Cloudinary (required to store generated images/videos)
CLOUD_NAME=your-cloudinary-cloud-name
CLOUD_API_KEY=your-cloudinary-api-key
CLOUD_API_SECRET=your-cloudinary-api-secret

# Google Gemini / Imagen / Veo (required by the current design/video services)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# Optional social integrations
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=